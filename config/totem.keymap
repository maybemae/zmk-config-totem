#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        at-symbol {
            bindings = <&kp AT>;
            key-positions = <12 13 11>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <1 2 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
              &kp Q       &kp W       &kp E          &kp R         &kp T        &kp Z    &kp U        &kp I        &kp O       &kp P
              &hm LGUI A  &hm LALT S  &hm LCTRL D    &hm LSHIFT F  &kp G        &kp H    &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMICOLON
&lt 5 ESCAPE  &kp Y       &kp X       &kp C          &kp V         &kp B        &kp N    &kp M        &kp COMMA    &kp DOT     &kp SLASH           &kp APOSTROPHE
                                      &mt LCTRL DEL  &lt 7 TAB     &kp SPACE    &kp RET  &lt 4 BSPC   &kp MINUS
            >;
        };

        nav2 {
            display-name = "Nav";
            bindings = <
              &kp TILDE       &kp EXCLAMATION  &kp PERCENT   &kp AMPERSAND  &kp LBRC    &kp RBRC  &kp SQT     &kp DOUBLE_QUOTES  &trans     &kp NUMBER_0
              &kp LEFT_SHIFT  &kp LEFT         &kp UP_ARROW  &kp RIGHT      &kp LBKT    &kp RBKT  &kp MINUS   &kp EQUAL          &kp PIPE   &kp MINUS
&kp LEFT_ALT  &kp LEFT_WIN    &kp PLUS         &kp DOWN      &kp COMMA      &kp LPAR    &kp RPAR  &kp PERIOD  &kp COLON          &kp SLASH  &kp KP_MULTIPLY  &kp HASH
                                               &trans        &trans         &trans      &trans    &trans      &trans
            >;
        };

        Num {
            bindings = <
        &kp F1                &kp F2                    &kp F3                  &kp F4                        &kp F5             &kp F6           &kp F7                         &kp F8                 &kp F9                &kp F10
        &hm LGUI KP_NUMBER_1  &hm LEFT_ALT KP_NUMBER_2  &hm LSHIFT KP_NUMBER_3  &hm LEFT_CONTROL KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &hm RIGHT_CONTROL KP_NUMBER_7  &hm RSHFT KP_NUMBER_8  &hm RALT KP_NUMBER_9  &hm RIGHT_META KP_NUMBER_0
&trans  &trans                &kp PLUS                  &trans                  &kp MINUS                     &trans             &trans           &trans                         &kp COMMA              &kp DOT               &kp F11                     &kp F12
                                                        &trans                  &trans                        &trans             &trans           &trans                         &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp KP_ASTERISK  &kp SQT  &kp DQT
                &trans    &trans  &trans    &trans      &trans         &trans     &trans         &trans           &trans   &trans
&studio_unlock  &trans    &trans  &trans    &trans      &trans         &kp UNDER  &kp EQUAL      &trans           &trans   &kp SLASH  &kp HOME
                                  &trans    &trans      &trans         &trans     &trans         &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &to 5     &trans  &trans  &trans  &kp END  &kp F1
        &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F10
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F20  &kp F7
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
            &kp Z           &kp X  &kp C      &kp V         &sl 6     &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
              &kp TILDE       &trans     &trans        &trans     &kp LBRC    &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
              &kp LEFT_SHIFT  &kp LEFT   &kp UP_ARROW  &kp RIGHT  &kp LBKT    &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp LEFT_ALT  &kp LEFT_WIN    &kp MINUS  &kp DOWN      &kp PLUS   &kp LPAR    &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &kp PLUS
                                         &trans        &trans     &trans      &trans    &trans        &kp DOT
            >;
        };
    };
};
