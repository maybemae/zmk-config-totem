#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
              &kp Q       &kp W       &kp E               &kp R               &kp T      &kp DE_Z  &kp U                &kp I              &kp O       &kp P
              &hm LGUI A  &hm LALT S  &hm LSHIFT D        &hm LEFT_CONTROL F  &kp G      &kp H     &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RALT L  &hm RGUI DE_O_UMLAUT
&lt 0 ESCAPE  &kp DE_Y    &kp X       &kp C               &kp V               &kp B      &kp N     &kp M                &trans             &trans      &kp DE_U_UMLAUT       &sl 3
                                      &mt LCTRL C_REPEAT  &lt 0 SPACE         &kp TAB    &kp RET   &lt 0 BSPC           &trans
            >;
        };

        nav {
            bindings = <
          &trans     &kp N7  &kp N8  &kp N9  &trans    &trans    &trans    &trans  &trans     &trans
          &kp LGUI   &kp N4  &kp N5  &kp N6  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp LALT  &kp LCTRL  &kp N1  &kp N2  &kp N3  &trans    &trans    &trans    &trans  &trans     &trans  &trans
                             &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        symbols {
            bindings = <
          &kp        &kp DE_BACKSLASH  &kp EQUAL          &kp DE_LESS_THAN  &kp DE_LEFT_BRACE          &kp DE_RIGHT_BRACE        &kp DE_GREATER_THAN  &kp DE_EXCLAMATION  &kp DE_QUESTION      &kp DE_DOLLAR
          &kp LGUI   &kp DE_SLASH      &kp DE_MINUS       &kp DE_PLUS       &kp DE_LEFT_PARENTHESIS    &kp DE_RIGHT_PARENTHESIS  &kp DE_COMMA         &kp DE_PERIOD       &kp DE_SINGLE_QUOTE  &kp DE_HASH
&kp LALT  &kp LCTRL  &kp DE_PIPE       &kp DE_UNDERSCORE  &kp DE_STAR       &kp DE_LEFT_BRACKET        &kp RBKT                  &kp SEMICOLON        &kp DE_COLON        &kp DOUBLE_QUOTES    &kp DE_PERCENT  &kp DE_AMPERSAND
                                       &kp                &kp               &kp                        &kp                       &kp                  &kp
            >;
        };

        german {
            bindings = <
        &trans           &trans         &trans  &trans  &trans    &trans  &kp DE_U_UMLAUT  &trans  &kp DE_O_UMLAUT  &trans
        &kp DE_A_UMLAUT  &kp DE_ESZETT  &trans  &trans  &trans    &trans  &trans           &trans  &trans           &trans
&trans  &trans           &trans         &trans  &trans  &trans    &trans  &trans           &trans  &trans           &trans  &trans
                                        &trans  &trans  &trans    &trans  &trans           &trans
            >;
        };

        func {
            bindings = <
        &none   &none   &none   &kp C_BRI_DN  &kp C_BRI_UP    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOLUME_UP
        &kp F2  &kp F3  &kp F4  &kp F5        &kp F6          &kp F7      &kp F8            &kp F9      &kp F10       &kp F11
&kp F1  &none   &none   &none   &none         &none           &none       &none             &none       &none         &none            &kp F12
                        &none   &none         &none           &none       &none             &none
            >;
        };
    };
};
